# Server-only values. Never commit credentials or expose them to browser/build variables.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
DATA_ENCRYPTION_KEY=GENERATE_SEPARATE_32_BYTE_HEX_KEY
APP_ORIGIN=https://plan.retirementexpert.si
COOKIE_LOCAL_HTTP=false
# Only use the development Preview compatibility flag in its verified environment.
# PREVIEW_PROXY_INTERNAL_ORIGIN=http://127.0.0.1:3000
# Real advisor ID returned by authorized bootstrap; no public signup.
INTAKE_ADVISOR_ID=
# Chromium must exist and be executable in the actual Hostinger app runtime.
CHROMIUM_EXECUTABLE_PATH=
REPORT_DOWNLOAD_HMAC_CONFIGURED=false
# Mail token must be scoped to the authorized LSRT mailbox. Sending stays held.
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAIL_SENDER_VERIFIED=false
OPERATIONS_OUTBOX_DISPATCH_APPROVED=false
OPERATIONS_CRON_HMAC_SECRET=GENERATE_SEPARATE_RANDOM_32_PLUS_CHARACTER_SECRET
# Production intake remains closed until these independent checks are approved.
REAL_CLIENT_INTAKE_ENABLED=false
COMPLIANCE_APPROVED_REAL_CLIENT_INTAKE=false
PRIVATE_STORAGE_VERIFIED=false
HOSTINGER_RUNTIME_CONFIGURED=false
RETENTION_POLICY_APPROVED=false
LEGAL_HOLD_PROCESS_APPROVED=false
BACKUP_RESTORE_APPROVED=false
BACKUP_RESTORE_TESTED_AT=
# Encrypted backup destination must be private and separately copied off-host.
BACKUP_EXECUTE=false
BACKUP_APPROVED=false
BACKUP_RETENTION_APPROVED=false
BACKUP_ENCRYPTION_KEY=GENERATE_SEPARATE_32_BYTE_HEX_KEY
BACKUP_OUTPUT_DIR=
BACKUP_RETENTION_DAYS=30
# Isolated restore target only; never set a production-restore danger flag by default.
BACKUP_RESTORE_DATABASE_URL=
# One-time advisor provisioning only. Remove after storing the password hash.
ADVISOR_NAME=
ADVISOR_EMAIL=
ADVISOR_PASSWORD=
# Runtime scheduler must exist on the actual host. Defaults do not send reminders.
ANNUAL_REVIEW_ENABLED=false
# Optional AI never receives raw intake, health or uploaded documents.
# Template narratives work with all these keys blank/disabled.
NARRATIVE_AI_ENABLED=false
NARRATIVE_AI_DATA_SHARING_APPROVED=false
NARRATIVE_AI_BASE_URL=
NARRATIVE_AI_API_KEY=
NARRATIVE_AI_MODEL=
NARRATIVE_AI_TIMEOUT_MS=8000
# All portal emails are currently restricted in server code to brokerjesse247@gmail.com.
# Sender and live dispatch remain held until verified on the real runtime.
OPERATIONS_OUTBOX_LIMIT=2
OPERATIONS_SCHEDULER_VERIFIED=false
BACKUP_OFFHOST_VERIFIED=false
