# Server-only values: never commit actual credentials or expose them to the browser.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
DATA_ENCRYPTION_KEY=GENERATE_32_BYTE_HEX_KEY
APP_ORIGIN=https://plan.retirementexpert.si
COOKIE_LOCAL_HTTP=false
INTAKE_ACCEPT_REAL_DATA=false
# Real advisor ID returned after authorized bootstrap. No public signup.
INTAKE_ADVISOR_ID=
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAIL_SENDER_VERIFIED=false
# One-time provisioning only; remove these after creating the advisor.
ADVISOR_NAME=
ADVISOR_EMAIL=
ADVISOR_PASSWORD=
