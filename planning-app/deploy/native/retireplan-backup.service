[Unit]
Description=RetirementExpert approved encrypted database backup
After=mysql.service

[Service]
Type=oneshot
User=retireplan
Group=retireplan
WorkingDirectory=/opt/retireplan/current
EnvironmentFile=/etc/retireplan/runtime.env
ExecStart=/usr/bin/node /opt/retireplan/current/node_modules/tsx/dist/cli.mjs /opt/retireplan/current/scripts/backup-create.ts
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/retireplan/backups
TimeoutStartSec=600
