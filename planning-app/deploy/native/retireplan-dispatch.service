[Unit]
Description=RetirementExpert signed private queue dispatch
After=retireplan-app.service
Requires=retireplan-app.service

[Service]
Type=oneshot
User=retireplan
Group=retireplan
WorkingDirectory=/opt/retireplan/current
EnvironmentFile=/etc/retireplan/runtime.env
Environment=HOME=/var/lib/retireplan
ExecStart=/usr/bin/node /opt/retireplan/current/node_modules/tsx/dist/cli.mjs /opt/retireplan/current/scripts/operations-dispatch.ts
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=330
